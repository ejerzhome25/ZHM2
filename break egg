    end

    makeHandle("DragLeft", UDim2.fromOffset(0, 0), UDim2.new(0, thickness, 1, 0))
    makeHandle("DragRight", UDim2.new(1, 0, 0, 0), UDim2.new(0, thickness, 1, 0), Vector2.new(1, 0))
    makeHandle("DragBottom", UDim2.new(0, 0, 1, 0), UDim2.new(1, 0, 0, thickness), Vector2.new(0, 1))

    return handles
end

function UI.bindSmoothScrolling(scroller, layout)
    -- Reliable mobile scrolling:
    -- 1) Roblox native finger scrolling remains ENABLED.
    -- 2) CanvasSize is synchronized manually so dropdown/resize changes cannot
    --    leave the ScrollingFrame with a stale or invalid scroll range.
    -- 3) A dedicated right-side rail offers drag/tap scrolling plus ▲/▼ fallbacks.
    --
    -- This deliberately avoids global content-touch interception, which could
    -- fight buttons, resizing, window dragging, or Roblox's own touch scroller.
    if not scroller or not layout then
        return
    end

    local BRIGHT_PURPLE = Color3.fromRGB(139, 92, 246)
    local LIGHT_PURPLE = Color3.fromRGB(216, 205, 255)
    local DEEP_PURPLE = Color3.fromRGB(91, 33, 182)

    scroller.AutomaticCanvasSize = Enum.AutomaticSize.None
    scroller.ScrollingDirection = Enum.ScrollingDirection.Y
    scroller.Active = true
    scroller.ScrollingEnabled = true
    scroller.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    -- Keep Roblox's native bar visible as a fallback on both mobile and PC.
    scroller.ScrollBarThickness = IS_TOUCH_DEVICE and 5 or 5
    scroller.ScrollBarImageColor3 = IS_TOUCH_DEVICE and LIGHT_PURPLE or BRIGHT_PURPLE
    scroller.ScrollBarImageTransparency = IS_TOUCH_DEVICE and 0.10 or 0.05

    pcall(function()
        scroller.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
    end)

    local destroyed = false
    local updateQueued = false
    local thumbParent = scroller.Parent

    local railGlow = nil
    local railButton = nil
    local upButton = nil
    local downButton = nil
    local thumbShadow = nil
    local thumb = nil

    local railTouch = nil
    local railDragging = false

    local function getCanvasHeight()
        return math.max(
            0,
            math.ceil(layout.AbsoluteContentSize.Y + (IS_TOUCH_DEVICE and 12 or 12))
        )
    end

    local function getMaxScrollY()
        return math.max(
            0,
            getCanvasHeight() - math.max(0, scroller.AbsoluteWindowSize.Y)
        )
    end

    local function setScrollY(y)
        if destroyed or not scroller.Parent then
            return
        end

        local maxY = getMaxScrollY()
        scroller.CanvasPosition = Vector2.new(
            0,
            math.clamp(tonumber(y) or 0, 0, maxY)
        )
    end

    local function getRailGeometry()
        if not railButton or not railButton.Parent then
            return nil
        end

        local parentAbs = thumbParent.AbsolutePosition
        local scrollAbs = scroller.AbsolutePosition
        local scrollSize = scroller.AbsoluteSize

        -- Compact visual size. PC gets a slim rail; mobile stays finger-friendly.
        local laneWidth = IS_TOUCH_DEVICE and 28 or 18
        local topGap = IS_TOUCH_DEVICE and 30 or 24
        local bottomGap = IS_TOUCH_DEVICE and 30 or 24

        -- Pin the custom scrollbar to the OUTER right edge of the VNDT window
        -- instead of keeping it inset inside the ScrollingFrame.
        local rightEdgePadding = 2
        local left = math.max(0, thumbParent.AbsoluteSize.X - laneWidth - rightEdgePadding)
        local top = scrollAbs.Y - parentAbs.Y + 5
        local totalHeight = math.max(110, scrollSize.Y - 10)

        local railTop = top + topGap
        local railHeight = math.max(44, totalHeight - topGap - bottomGap)

        return left, top, laneWidth, totalHeight, railTop, railHeight
    end

    local function scrollFromScreenY(screenY)
        local geometry = {getRailGeometry()}
        if #geometry < 6 then
            return
        end

        local _, _, _, _, railTop, railHeight = table.unpack(geometry)
        local parentY = thumbParent.AbsolutePosition.Y
        local localY = screenY - parentY
        local progress = math.clamp((localY - railTop) / math.max(1, railHeight), 0, 1)
        setScrollY(progress * getMaxScrollY())
    end

    if thumbParent then
        railGlow = Instance.new("Frame")
        railGlow.Name = "MobileScrollRailGlow"
        railGlow.BackgroundColor3 = BRIGHT_PURPLE
        railGlow.BackgroundTransparency = 0.82
        railGlow.BorderSizePixel = 0
        railGlow.ZIndex = 314
        railGlow.Visible = false
        railGlow.Parent = thumbParent
        UI.addCorner(railGlow, 11)

        -- The rail itself is the touch target. It is intentionally a real GuiButton,
        -- so Roblox owns the touch capture while the finger is on this control.
        railButton = Instance.new("TextButton")
        railButton.Name = "MobileScrollRail"
        railButton.BackgroundColor3 = Color3.fromRGB(34, 23, 58)
        railButton.BackgroundTransparency = 0.08
        railButton.BorderSizePixel = 0
        railButton.AutoButtonColor = false
        railButton.Text = ""
        railButton.ZIndex = 315
        railButton.Active = true
        railButton.Visible = false
        railButton.Parent = thumbParent
        UI.addCorner(railButton, 10)
        UI.addStroke(railButton, LIGHT_PURPLE, 1, 0.08)

        local railGradient = Instance.new("UIGradient")
        railGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(52, 35, 83)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(38, 26, 65)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(29, 20, 48))
        })
        railGradient.Rotation = 90
        railGradient.Parent = railButton

        local railAccent = Instance.new("Frame")
        railAccent.Name = "AccentTrack"
        railAccent.AnchorPoint = Vector2.new(0.5, 0)
        railAccent.Position = UDim2.new(0.5, 0, 0, 6)
        railAccent.Size = UDim2.new(0, IS_TOUCH_DEVICE and 4 or 3, 1, -12)
        railAccent.BackgroundColor3 = BRIGHT_PURPLE
        railAccent.BackgroundTransparency = 0.12
        railAccent.BorderSizePixel = 0
        railAccent.ZIndex = 316
        railAccent.Parent = railButton
        UI.addCorner(railAccent, 3)

        local accentGradient = Instance.new("UIGradient")
        accentGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, LIGHT_PURPLE),
            ColorSequenceKeypoint.new(0.5, BRIGHT_PURPLE),
            ColorSequenceKeypoint.new(1, DEEP_PURPLE)
        })
        accentGradient.Rotation = 90
        accentGradient.Parent = railAccent

        thumbShadow = Instance.new("Frame")
        thumbShadow.Name = "MobileScrollThumbShadow"
        thumbShadow.AnchorPoint = Vector2.new(0.5, 0.5)
        thumbShadow.Size = UDim2.fromOffset(IS_TOUCH_DEVICE and 24 or 14, IS_TOUCH_DEVICE and 28 or 26)
        thumbShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        thumbShadow.BackgroundTransparency = 0.45
        thumbShadow.BorderSizePixel = 0
        thumbShadow.ZIndex = 317
        thumbShadow.Parent = railButton
        UI.addCorner(thumbShadow, 10)

        thumb = Instance.new("Frame")
        thumb.Name = "MobileScrollThumb"
        thumb.AnchorPoint = Vector2.new(0.5, 0.5)
        thumb.Size = UDim2.fromOffset(IS_TOUCH_DEVICE and 20 or 12, IS_TOUCH_DEVICE and 24 or 22)
        thumb.BackgroundColor3 = BRIGHT_PURPLE
        thumb.BackgroundTransparency = 0
        thumb.BorderSizePixel = 0
        thumb.ZIndex = 318
        thumb.Parent = railButton
        UI.addCorner(thumb, 9)
        UI.addStroke(thumb, Color3.fromRGB(255, 255, 255), 1, 0.05)

        local thumbGradient = Instance.new("UIGradient")
        thumbGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, LIGHT_PURPLE),
            ColorSequenceKeypoint.new(0.48, BRIGHT_PURPLE),
            ColorSequenceKeypoint.new(1, DEEP_PURPLE)
        })
        thumbGradient.Rotation = 90
        thumbGradient.Parent = thumb

        local gripLabel = UI.makeText(
            thumb,
            "≡",
            IS_TOUCH_DEVICE and 14 or 11,
            Color3.fromRGB(255, 255, 255),
            Enum.Font.GothamBold,
            Enum.TextXAlignment.Center
        )
        gripLabel.Size = UDim2.fromScale(1, 1)
        gripLabel.ZIndex = 319

        local function makeArrowButton(name, symbol)
            local button = Instance.new("TextButton")
            button.Name = name
            button.BackgroundColor3 = BRIGHT_PURPLE
            button.BackgroundTransparency = 0
            button.BorderSizePixel = 0
            button.AutoButtonColor = true
            button.Text = symbol
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.TextSize = IS_TOUCH_DEVICE and 14 or 11
            button.Font = Enum.Font.GothamBold
            button.ZIndex = 320
            button.Active = true
            button.Visible = false
            button.Parent = thumbParent
            UI.addCorner(button, 9)
            UI.addStroke(button, Color3.fromRGB(255, 255, 255), 1, 0.08)

            local gradient = Instance.new("UIGradient")
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, LIGHT_PURPLE),
                ColorSequenceKeypoint.new(0.5, BRIGHT_PURPLE),
                ColorSequenceKeypoint.new(1, DEEP_PURPLE)
            })
            gradient.Rotation = 90
            gradient.Parent = button

            return button
        end

        upButton = makeArrowButton("MobileScrollUp", "▲")
        downButton = makeArrowButton("MobileScrollDown", "▼")

        local function pageAmount()
            return math.max(90, scroller.AbsoluteWindowSize.Y * 0.65)
        end

        upButton.Activated:Connect(function()
            setScrollY(scroller.CanvasPosition.Y - pageAmount())
        end)

        downButton.Activated:Connect(function()
            setScrollY(scroller.CanvasPosition.Y + pageAmount())
        end)

        -- Dragging/tapping anywhere on the rail directly maps the finger position
        -- to scroll progress. This avoids delta-state desync and "stuck" thumbs.
        railButton.InputBegan:Connect(function(input)
            local t = input.UserInputType
            if t ~= Enum.UserInputType.Touch
                and t ~= Enum.UserInputType.MouseButton1 then
                return
            end

            railTouch = input
            railDragging = true
            scrollFromScreenY(input.Position.Y)
        end)

        railButton.InputChanged:Connect(function(input)
            if not railDragging or input ~= railTouch then
                return
            end

            scrollFromScreenY(input.Position.Y)
        end)

        railButton.InputEnded:Connect(function(input)
            if input ~= railTouch then
                return
            end

            scrollFromScreenY(input.Position.Y)
            railDragging = false
            railTouch = nil
        end)

        -- Executor/mobile fallback: some clients report movement globally instead
        -- of through GuiObject.InputChanged. Keep this tiny listener rail-only.
        UserInputService.InputChanged:Connect(function(input)
            if not railDragging then
                return
            end

            -- Touch usually keeps the same InputObject. Mouse dragging reports
            -- MouseMovement separately from the original MouseButton1 press.
            if railTouch and railTouch.UserInputType == Enum.UserInputType.Touch then
                if input ~= railTouch then
                    return
                end
            elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end

            scrollFromScreenY(input.Position.Y)
        end)

        UserInputService.InputEnded:Connect(function(input)
            if not railDragging then
                return
            end

            local endedTouch = railTouch
                and railTouch.UserInputType == Enum.UserInputType.Touch
                and input == railTouch
            local endedMouse = railTouch
                and railTouch.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1

            if not endedTouch and not endedMouse then
                return
            end

            railDragging = false
            railTouch = nil
        end)
    end

    local function updateVisuals()
        if destroyed or not thumbParent then
            return
        end

        local maxY = getMaxScrollY()
        local geometry = {getRailGeometry()}

        if #geometry < 6 then
            return
        end

        local left, top, laneWidth, totalHeight, railTop, railHeight = table.unpack(geometry)
        local hasScroll = maxY > 1
        -- Show the custom rail on both touch devices and PC executors.
        local shouldShow = scroller.Visible

        for _, object in ipairs({
            railGlow,
            railButton,
            upButton,
            downButton,
        }) do
            if object then
                object.Visible = shouldShow
            end
        end

        if not shouldShow then
            return
        end

        railGlow.Position = UDim2.fromOffset(left - 3, railTop - 3)
        railGlow.Size = UDim2.fromOffset(laneWidth + 6, railHeight + 6)

        railButton.Position = UDim2.fromOffset(left, railTop)
        railButton.Size = UDim2.fromOffset(laneWidth, railHeight)

        upButton.Position = UDim2.fromOffset(left + 3, top)
        local arrowHeight = IS_TOUCH_DEVICE and 24 or 18
        upButton.Size = UDim2.fromOffset(math.max(12, laneWidth - 4), arrowHeight)

        downButton.Position = UDim2.fromOffset(
            left + 3,
            top + totalHeight - arrowHeight
        )
        downButton.Size = UDim2.fromOffset(math.max(12, laneWidth - 4), arrowHeight)

        railButton.BackgroundTransparency = hasScroll and 0.08 or 0.45
        upButton.BackgroundTransparency = hasScroll and 0 or 0.45
        downButton.BackgroundTransparency = hasScroll and 0 or 0.45

        if thumb and thumbShadow then
            local progress = 0
            if maxY > 0 then
                progress = math.clamp(scroller.CanvasPosition.Y / maxY, 0, 1)
            end

            local thumbHalf = IS_TOUCH_DEVICE and 13 or 11
            local usable = math.max(1, railHeight - thumbHalf * 2)
            local y = thumbHalf + progress * usable

            thumb.Position = UDim2.new(0.5, 0, 0, math.floor(y + 0.5))
            thumbShadow.Position = UDim2.new(0.5, 3, 0, math.floor(y + 3.5))
            thumb.BackgroundTransparency = hasScroll and 0 or 0.35
        end
    end

    local function updateCanvasNow()
        updateQueued = false

        if destroyed or not scroller.Parent or not layout.Parent then
            return
        end

        local canvasHeight = getCanvasHeight()
        scroller.CanvasSize = UDim2.fromOffset(0, canvasHeight)

        -- Always keep CanvasPosition legal after a dropdown closes, the window
        -- resizes, or the viewport changes.
        setScrollY(scroller.CanvasPosition.Y)

        -- Defensive reset: if another UI path ever disables native scrolling,
        -- immediately re-enable it.
        if not scroller.ScrollingEnabled then
            scroller.ScrollingEnabled = true
        end

        updateVisuals()
    end

    local function queueUpdate()
        if destroyed or updateQueued then
            return
        end

        updateQueued = true
        task.defer(function()
            -- Two scheduler steps are cheap and make nested AutomaticSize dropdowns
            -- much more reliable before reading UIListLayout.AbsoluteContentSize.
            task.wait()
            task.wait()
            updateCanvasNow()
        end)
    end

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(queueUpdate)
    scroller:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(queueUpdate)
    scroller:GetPropertyChangedSignal("AbsolutePosition"):Connect(queueUpdate)
    scroller:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueUpdate)
    scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(updateVisuals)
    scroller:GetPropertyChangedSignal("Visible"):Connect(updateVisuals)

    scroller.DescendantAdded:Connect(queueUpdate)
    scroller.DescendantRemoving:Connect(queueUpdate)

    scroller.AncestryChanged:Connect(function(_, parent)
        if parent ~= nil then
            return
        end

        destroyed = true
        railDragging = false
        railTouch = nil

        for _, object in ipairs({
            railGlow,
            railButton,
            upButton,
            downButton,
        }) do
            if object and object.Parent then
                pcall(function()
                    object:Destroy()
                end)
            end
        end
    end)

    -- Extra recovery whenever the user touches the native scroller.
    scroller.InputBegan:Connect(function()
        if not scroller.ScrollingEnabled then
            scroller.ScrollingEnabled = true
        end
        queueUpdate()
    end)

    updateCanvasNow()
end

function UI.makeResizable(frame, onResize, canResize)
    -- One compact bottom-right grip. Keeping resize logic inside this function
    -- avoids adding more long-lived locals to the main chunk.
    local grip = Instance.new("TextButton")
    grip.Name = "ResizeGrip"
    grip.AnchorPoint = Vector2.new(1, 1)
    grip.Position = UDim2.new(1, -4, 1, -4)
    grip.Size = IS_TOUCH_DEVICE and UDim2.fromOffset(20, 20) or UDim2.fromOffset(18, 18)
    grip.BackgroundColor3 = THEME.surface2
    grip.BackgroundTransparency = IS_TOUCH_DEVICE and 0.08 or 0.18
    grip.BorderSizePixel = 0
    grip.AutoButtonColor = false
    grip.Text = "◢"
    grip.TextColor3 = THEME.muted
    grip.TextSize = IS_TOUCH_DEVICE and 11 or 10
    grip.Font = Enum.Font.GothamBold
    grip.ZIndex = 250
    grip.Active = true
    grip.Parent = frame
    UI.addCorner(grip, 5)
    UI.addStroke(grip, THEME.line, 1, 0.50)

    local resizing = false
    local activeInput = nil
    local startPointer = nil
    local startSize = nil
    local startPosition = nil
    local lastUpdate = 0

    local function viewportSize()
        local camera = Workspace.CurrentCamera
        return camera and camera.ViewportSize or Vector2.new(1280, 720)
    end

    local function limits(viewport)
        local minW
        local minH

        if IS_TOUCH_DEVICE then
            minW = math.min(220, math.max(170, viewport.X - 16))
            minH = math.min(260, math.max(190, viewport.Y - 20))
        else
            minW = 260
            minH = 260
        end

        local maxW = math.max(minW, viewport.X - 12)
        local maxH = math.max(minH, viewport.Y - 16)
        return minW, minH, maxW, maxH
    end

    local function clampCenter(position, width, height, viewport)
        local x = viewport.X * position.X.Scale + position.X.Offset
        local y = viewport.Y * position.Y.Scale + position.Y.Offset
        local margin = 4
        local halfW = width * 0.5
        local halfH = height * 0.5
        local minX = halfW + margin
        local maxX = viewport.X - halfW - margin
        local minY = halfH + margin
        local maxY = viewport.Y - halfH - margin

        if maxX < minX then
            x = viewport.X * 0.5
        else
            x = math.clamp(x, minX, maxX)
        end

        if maxY < minY then
            y = viewport.Y * 0.5
        else
            y = math.clamp(y, minY, maxY)
        end

        return UDim2.fromOffset(x, y)
    end

    grip.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
            return
        end
        if canResize and not canResize() then
            return
        end

        resizing = true
        activeInput = input
        startPointer = input.Position
        startSize = frame.AbsoluteSize
        startPosition = frame.Position
        lastUpdate = 0
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not resizing or not startPointer or not startSize or not startPosition then
            return
        end

        local isTouch = activeInput and activeInput.UserInputType == Enum.UserInputType.Touch
        if isTouch then
            if input ~= activeInput then
                return
            end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        if IS_TOUCH_DEVICE then
            local now = os.clock()
            if now - lastUpdate < (1 / 24) then
                return
            end
            lastUpdate = now
        end

        local viewport = viewportSize()
        local minW, minH, maxW, maxH = limits(viewport)
        local delta = input.Position - startPointer
        local newW = math.clamp(math.floor(startSize.X + delta.X + 0.5), minW, maxW)
        local newH = math.clamp(math.floor(startSize.Y + delta.Y + 0.5), minH, maxH)

        local dx = (newW - startSize.X) * 0.5
        local dy = (newH - startSize.Y) * 0.5
        local proposedPosition = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + dx,
            startPosition.Y.Scale,
            startPosition.Y.Offset + dy
        )

        frame.Size = UDim2.fromOffset(newW, newH)
        frame.Position = clampCenter(proposedPosition, newW, newH, viewport)

        if onResize then
            pcall(onResize, newW, newH)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not resizing then
            return
        end
        if input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
            activeInput = nil
            startPointer = nil
            startSize = nil
            startPosition = nil
        end
    end)

    return grip
end

function UI.getResponsiveSize()
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

    if IS_TOUCH_DEVICE then
        -- Balanced mobile size: clearly larger than the previous tiny panel,
        -- but still leaves plenty of the game visible.
        local width
        local height

        if viewport.X > viewport.Y then
            -- Landscape mobile/tablet.
            width = math.clamp(math.floor(viewport.X * 0.18), 250, 320)
            height = math.clamp(math.floor(viewport.Y * 0.44), 300, 390)
        else
            -- Portrait mobile.
            width = math.clamp(math.floor(viewport.X * 0.78), 260, 330)
            height = math.clamp(math.floor(viewport.Y * 0.50), 330, 470)
        end

        width = math.min(width, math.max(220, viewport.X - 16))
        height = math.min(height, math.max(260, viewport.Y - 20))

        return width, height
    end

    local width = math.clamp(math.floor(viewport.X * 0.82), 280, 340)
    local height = math.clamp(math.floor(viewport.Y * 0.68), 320, 455)

    if viewport.X >= 700 then
        width = 340
    end

    return width, height
end

