function UI.makeTouchDraggable(handle, frame, reserveRightButton)
    -- PERFORMANCE: all drag handles on the same VNDT frame share ONE global
    -- InputChanged/InputEnded pair instead of creating another global listener
    -- for every edge grip. This matters on mobile where touch events are frequent.
    UI._dragStates = UI._dragStates or setmetatable({}, {__mode = "k"})

    local state = UI._dragStates[frame]
    if not state then
        state = {
            dragging = false,
            dragInput = nil,
            dragStart = nil,
            startPosition = nil,
            lastDragUpdate = 0,
        }
        UI._dragStates[frame] = state

        local function clampFrameToViewport(position)
            local camera = Workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
            local size = frame.AbsoluteSize
            local halfW = size.X * 0.5
            local halfH = size.Y * 0.5
            local targetX = viewport.X * position.X.Scale + position.X.Offset
            local targetY = viewport.Y * position.Y.Scale + position.Y.Offset
            local margin = 4

            targetX = math.clamp(targetX, halfW + margin, viewport.X - halfW - margin)
            targetY = math.clamp(targetY, halfH + margin, viewport.Y - halfH - margin)

            return UDim2.fromOffset(targetX, targetY)
        end

        UserInputService.InputChanged:Connect(function(input)
            if not state.dragging or not state.dragStart or not state.startPosition then
                return
            end

            local isTouch = state.dragInput
                and state.dragInput.UserInputType == Enum.UserInputType.Touch

            if isTouch then
                if input ~= state.dragInput then
                    return
                end
            elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end

            if IS_TOUCH_DEVICE then
                local now = os.clock()
                if now - (state.lastDragUpdate or 0) < (1 / 30) then
                    return
                end
                state.lastDragUpdate = now
            end

            local delta = input.Position - state.dragStart
            local proposed = UDim2.new(
                state.startPosition.X.Scale,
                state.startPosition.X.Offset + delta.X,
                state.startPosition.Y.Scale,
                state.startPosition.Y.Offset + delta.Y
            )

            frame.Position = clampFrameToViewport(proposed)
        end)

        UserInputService.InputEnded:Connect(function(input)
            if not state.dragging then
                return
            end

            if input == state.dragInput
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                state.dragging = false
                state.dragInput = nil
                state.dragStart = nil
                state.startPosition = nil
            end
        end)
    end

    handle.Active = true

    handle.InputBegan:Connect(function(input)
        local inputType = input.UserInputType
        if inputType ~= Enum.UserInputType.MouseButton1
            and inputType ~= Enum.UserInputType.Touch then
            return
        end

        -- Header drag leaves the minimize/restore button clickable.
        if reserveRightButton then
            local screenX = input.Position.X
            local rightEdge = handle.AbsolutePosition.X + handle.AbsoluteSize.X
            local reserved = IS_TOUCH_DEVICE and 42 or 44
            if screenX >= rightEdge - reserved then
                return
            end
        end

        state.dragging = true
        state.dragInput = input
        state.dragStart = input.Position
        state.startPosition = frame.Position
        state.lastDragUpdate = 0
    end)
end

function UI.addAllEdgeDragHandles(frame)
    -- Thin transparent grip zones let mobile users drag from any outer side
    -- without covering the actual buttons in the center of the UI.
    local thickness = IS_TOUCH_DEVICE and 5 or 6
    local handles = {}

    local function makeHandle(name, position, size, anchorPoint)
        local grip = Instance.new("Frame")
        grip.Name = name
        grip.BackgroundTransparency = 1
        grip.BorderSizePixel = 0
        grip.Active = true
        grip.ZIndex = 80
        grip.AnchorPoint = anchorPoint or Vector2.new(0, 0)
        grip.Position = position
        grip.Size = size
        grip.Parent = frame
        table.insert(handles, grip)
        UI.makeTouchDraggable(grip, frame, false)
