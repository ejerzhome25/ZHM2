--// Shared live ProximityPrompt cache
-- One initial Workspace scan, then event-driven updates. This replaces repeated
-- Workspace:GetDescendants() prompt scans used by Auto Hatch / pickup checks.
local PROXIMITY_PROMPT_CACHE = setmetatable({}, {__mode = "k"})
local proximityPromptCacheStarted = false

local function ensureProximityPromptCache()
    if proximityPromptCacheStarted then
        return PROXIMITY_PROMPT_CACHE
    end

    proximityPromptCacheStarted = true

    -- Build the initial cache in small batches so large maps do not freeze mobile.
    local descendants = Workspace:GetDescendants()
    local batchSize = UserInputService.TouchEnabled and 320 or 700
    for index, object in ipairs(descendants) do
        if object:IsA("ProximityPrompt") then
            PROXIMITY_PROMPT_CACHE[object] = true
        end
        if index % batchSize == 0 then
            task.wait()
        end
    end

    Workspace.DescendantAdded:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            PROXIMITY_PROMPT_CACHE[object] = true
        end
    end)

    Workspace.DescendantRemoving:Connect(function(object)
        if PROXIMITY_PROMPT_CACHE[object] then
            PROXIMITY_PROMPT_CACHE[object] = nil
        end
    end)

    return PROXIMITY_PROMPT_CACHE
end

