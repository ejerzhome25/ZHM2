        PetEggAutomation.GetSelectedPet(),
        function(value)
            PetEggAutomation.SetSelectedPet(value)
            queueSaveConfig()
        end
    )

    PetEggAutomation.SetPetOptionsSink(function(names, counts, selected)
        if mergePetDropdown and mergePetDropdown.Refresh then
            mergePetDropdown.Refresh(names, counts, selected)
        end
    end)

    PetEggAutomation.SetStatusSink(function(message, kind)
        if statusSink then
            statusSink("Pet/Egg: " .. tostring(message), kind)
        end
    end)

    UI.createToggleRow(
        content,
        "Auto Merge",
        "Continuously merges 3 of the selected pet",
        8,
        PetEggAutomation.GetConfig().autoMergeEnabled,
        function(enabled)
            PetEggAutomation.SetAutoMerge(enabled)
            queueSaveConfig()
        end
    )

    local autoHatchToggle = UI.createToggleRow(
        content,
        "Auto Hatch",
        "Hatch prompts: scanning… • HIGHEST priority",
        9,
        PetEggAutomation.GetConfig().autoHatchEnabled,
        function(enabled)
            PetEggAutomation.SetAutoHatch(enabled)
            queueSaveConfig()
        end
    )

    PetEggAutomation.SetHatchCountSink(function(total)
        if autoHatchToggle and autoHatchToggle.SetDescription then
            autoHatchToggle.SetDescription(
                "Hatch prompts: " .. tostring(total) .. " • HIGHEST priority"
            )
        end
    end)

    local autoPlaceEggToggle = UI.createToggleRow(
        content,
        "Auto Place Eggs",
        "Eggs: scanning… • priority below Auto Hatch",
        10,
        PetEggAutomation.GetConfig().autoPlaceEggsEnabled,
        function(enabled)
            PetEggAutomation.SetAutoPlaceEggs(enabled)
            queueSaveConfig()
        end
    )

    PetEggAutomation.SetEggCountSink(function(total)
        if autoPlaceEggToggle and autoPlaceEggToggle.SetDescription then
            autoPlaceEggToggle.SetDescription(
                "Eggs: " .. tostring(total) .. " • priority below Auto Hatch"
            )
        end
    end)

    UI.createActionRow(
        content,
        "Place Eggs Now",
        "Places every detected egg inside your plot",
        "PLACE",
        11,
        function()
            PetEggAutomation.PlaceNow()
        end
    )

    UI.createActionRow(
        content,
        "Refresh My Base",
        "Rebuilds safe interior egg positions",
        "SCAN",
        12,
        function()
            PetEggAutomation.RefreshBase()
        end
    )

    UI.createSectionLabel(content, "Utilities", 13)


    UI.createToggleRow(
        content,
        "Anti AFK",
        "Prevents Roblox idle disconnects",
        14,
        antiAfkEnabled,
        function(enabled)
            antiAfkEnabled = enabled
            queueSaveConfig()

            if enabled then
                startAntiAfk()
            else
                stopAntiAfk()
            end

            setStatus(
                enabled and "Anti AFK enabled • active keep-alive" or "Anti AFK disabled",
                enabled and "success" or "warning"
            )
        end
    )

    UI.createToggleRow(
        content,
        "FPS Booster",
        "Low graphics • removes effects/textures • FPS counter",
        15,
        fpsBoosterEnabled,
        function(enabled)
            setFpsBoosterEnabled(enabled)
            queueSaveConfig()

            setStatus(
                enabled and "FPS Booster enabled" or "FPS Booster disabled • visuals restored",
                enabled and "success" or "warning"
            )
        end
    )

    UI.createActionRow(
        content,
        "Save Config",
        "Changes auto-save • tap to save now",
        "SAVE",
        16,
        function()
            local ok, err = saveConfigNow()
            if ok then
                setStatus("Config saved • auto-load ready", "success")
            else
                setStatus("Config save unavailable: " .. tostring(err), "warning")
            end
        end
    )

    UI.createToggleRow(
        content,
        "Auto Buy Pickaxe",
        "Buys and equips the best affordable tier",
        17,
        autoBuyEnabled,
        function(enabled)
            autoBuyEnabled = enabled
            queueSaveConfig()
            if enabled then
                task.spawn(runAutoBuyPickaxe)
            end
        end
    )

    UI.createToggleRow(
        content,
        "Upgrade Plot",
        "Continuously requests the next plot upgrade",
        18,
        upgradePlotEnabled,
        function(enabled)
            upgradePlotEnabled = enabled
            queueSaveConfig()
            if enabled then
                task.spawn(runUpgradePlot)
            end
        end
    )

    UI.createSectionLabel(content, "Auto Sell", 19)

    UI.createToggleRow(
        content,
        "Auto Sell",
        "Sells only the rarities selected below",
        20,
        sellAllEnabled,
        function(enabled)
            sellAllEnabled = enabled
            queueSaveConfig()
            if enabled then
                task.spawn(runSellAll)
            end
        end
    )

    local sellRarityDropdown = UI.createMultiSelectDropdown(
        content,
        "Sell Rarities",
        "Selected rarities will be sold automatically",
        21,
        selectedSellRarities,
        function()
            queueSaveConfig()
        end
    )

    rarityUiRefreshSink = function(list)
        if stealRarityDropdown and stealRarityDropdown.Refresh then
            stealRarityDropdown.Refresh(list)
        end
        if sellRarityDropdown and sellRarityDropdown.Refresh then
            sellRarityDropdown.Refresh(list)
        end
    end

    scanRarities()
    task.spawn(runRarityScanner)
    PetEggAutomation.Start()

    local footer = Instance.new("Frame")
    footer.Size = UDim2.new(1, 0, 0, IS_TOUCH_DEVICE and 12 or 28)
    footer.BackgroundTransparency = 1
    footer.LayoutOrder = 22
    footer.Parent = content

    local footerText = UI.makeText(
        footer,
        IS_TOUCH_DEVICE
            and "VNDT  •  Mobile mode  •  Config auto-saves"
            or "VNDT  •  Config auto-saves  •  FPS toggle",
        IS_TOUCH_DEVICE and 5 or 9,
        THEME.muted,
        Enum.Font.GothamBold,
        Enum.TextXAlignment.Center
    )
    footerText.Size = UDim2.fromScale(1, 1)

    UI.makeTouchDraggable(header, mainFrame, true)
    UI.addAllEdgeDragHandles(mainFrame)

    local minimized = false
    local userResized = false

    local resizeHandle = UI.makeResizable(
        mainFrame,
        function(newW, newH)
            if not minimized then
                mainWidth = newW
                mainHeight = newH
                expandedSize = UDim2.fromOffset(newW, newH)
                userResized = true
            end
        end,
        function()
            return not minimized
        end
    )

    local function syncShadow()
        shadow.Position = mainFrame.Position
        shadow.Size = UDim2.new(
            mainFrame.Size.X.Scale,
            mainFrame.Size.X.Offset + 12,
            mainFrame.Size.Y.Scale,
            mainFrame.Size.Y.Offset + 12
        )
        shadow.Visible = mainFrame.Visible
    end

    mainFrame:GetPropertyChangedSignal("Position"):Connect(syncShadow)
    mainFrame:GetPropertyChangedSignal("Size"):Connect(syncShadow)

    minimize.Activated:Connect(function()
        minimized = not minimized

        if minimized then
            if resizeHandle then
                resizeHandle.Visible = false
            end
            content.Visible = false
            divider.Visible = false
            brandDot.Visible = false
            subtitle.Visible = false

            -- Reposition title/buttons for the tiny minimized bar.
            title.Position = UDim2.fromOffset(IS_TOUCH_DEVICE and 5 or 12, 0)
            title.Size = UDim2.new(1, IS_TOUCH_DEVICE and -31 or -52, 1, 0)
            title.TextSize = IS_TOUCH_DEVICE and 8 or 13

            minimize.Text = "+"
            minimize.Position = UDim2.new(1, IS_TOUCH_DEVICE and -4 or -7, 0.5, 0)
            minimize.AnchorPoint = Vector2.new(1, 0.5)
            minimize.Size = IS_TOUCH_DEVICE and UDim2.fromOffset(19, 18) or UDim2.fromOffset(28, 26)

            UI.tween(mainFrame, 0.16, {
                Size = UDim2.fromOffset(MINIMIZED_WIDTH, MINIMIZED_HEIGHT)
            })
        else
            if resizeHandle then
                resizeHandle.Visible = true
            end
            content.Visible = true
            divider.Visible = true
            brandDot.Visible = true
            subtitle.Visible = true

            title.Position = IS_TOUCH_DEVICE and UDim2.fromOffset(25, 2) or UDim2.fromOffset(46, 4)
            title.Size = UDim2.new(1, IS_TOUCH_DEVICE and -51 or -94, 0, IS_TOUCH_DEVICE and 13 or 21)
            title.TextSize = IS_TOUCH_DEVICE and 9 or 15

            minimize.Text = "—"
            minimize.AnchorPoint = Vector2.new(1, 0)
            minimize.Position = IS_TOUCH_DEVICE and UDim2.new(1, -4, 0, 4) or UDim2.new(1, -9, 0, 9)
            minimize.Size = IS_TOUCH_DEVICE and UDim2.fromOffset(20, 20) or UDim2.fromOffset(32, 28)

            UI.tween(mainFrame, 0.16, {Size = expandedSize})
        end
    end)

    local camera = Workspace.CurrentCamera
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local newWidth, newHeight = UI.getResponsiveSize()
            local viewport = camera.ViewportSize

            if userResized then
                local minW = IS_TOUCH_DEVICE and math.min(220, math.max(170, viewport.X - 16)) or 260
                local minH = IS_TOUCH_DEVICE and math.min(260, math.max(190, viewport.Y - 20)) or 260
                local maxW = math.max(minW, viewport.X - 12)
                local maxH = math.max(minH, viewport.Y - 16)
                mainWidth = math.clamp(expandedSize.X.Offset, minW, maxW)
                mainHeight = math.clamp(expandedSize.Y.Offset, minH, maxH)
            else
                mainWidth = newWidth
                mainHeight = newHeight
            end

            expandedSize = UDim2.fromOffset(mainWidth, mainHeight)

            if minimized then
                mainFrame.Size = UDim2.fromOffset(MINIMIZED_WIDTH, MINIMIZED_HEIGHT)
            else
                mainFrame.Size = expandedSize
            end

            syncShadow()
        end)
    end

    -- Auto-resume saved ON states after the UI has loaded.
    if configLoaded then
        highestHpPriorityEnabled = autoStealEnabled

        if autoStealEnabled and getSelectedCount(selectedStealRarities) > 0 then
            task.spawn(runAutoSteal)
        end

        if autoBuyEnabled then
            task.spawn(runAutoBuyPickaxe)
        end

        if upgradePlotEnabled then
            task.spawn(runUpgradePlot)
        end

        if sellAllEnabled then
            task.spawn(runSellAll)
        end

        if fpsBoosterEnabled then
            setFpsBoosterEnabled(true)
        end

        if antiAfkEnabled then
            startAntiAfk()
        end

        task.defer(function()
            setStatus("Saved config auto-loaded", "success")
        end)
    end

    syncShadow()
end

--// Keyless entry point
UI.launchMainGui()
