--// Anti AFK
local antiAfkIdleConnection = nil
local antiAfkWorkerToken = 0
local disabledIdleConnections = {}

local function performAntiAfkActivity()
    if not antiAfkEnabled then
        return
    end

    local camera = Workspace.CurrentCamera
    local cameraCF = camera and camera.CFrame or CFrame.new()

    -- VirtualUser works as the main cross-platform fallback.
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1, 1), cameraCF)
        task.wait(0.04)
        VirtualUser:Button1Up(Vector2.new(1, 1), cameraCF)
    end)

    if IS_TOUCH_DEVICE then
        -- Mobile/touch executors differ in how SendTouchEvent is exposed.
        -- Try common signatures safely; failures are ignored.
        local viewport = camera and camera.ViewportSize or Vector2.new(400, 800)
        local x = math.floor(viewport.X * 0.5)
        local y = math.floor(viewport.Y * 0.82)

        pcall(function()
            VirtualInputManager:SendTouchEvent(0, 0, x, y)
            task.wait(0.03)
            VirtualInputManager:SendTouchEvent(0, 2, x, y)
        end)

        pcall(function()
            VirtualInputManager:SendTouchEvent(
                0,
                Enum.UserInputState.Begin,
                x,
                y
            )
            task.wait(0.03)
            VirtualInputManager:SendTouchEvent(
                0,
                Enum.UserInputState.End,
                x,
                y
            )
        end)
    else
        -- Desktop fallback: tiny mouse movement + harmless key pulse.
        pcall(function()
            local pos = UserInputService:GetMouseLocation()
            VirtualInputManager:SendMouseMoveEvent(pos.X + 1, pos.Y, game)
            task.wait(0.03)
            VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
        end)

        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
            task.wait(0.02)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end)
    end
end

local function disableRobloxIdleConnections()
    disabledIdleConnections = {}

    if type(getconnections) ~= "function" then
        return
    end

    local ok, connections = pcall(function()
        return getconnections(LocalPlayer.Idled)
    end)

    if not ok or type(connections) ~= "table" then
        return
    end

    for _, connection in ipairs(connections) do
        local disabled = false

        if connection and type(connection.Disable) == "function" then
            local success = pcall(function()
                connection:Disable()
            end)
            disabled = success
        elseif connection and type(connection.Disconnect) == "function" then
            -- Do NOT permanently disconnect if Disable isn't available.
            -- Keep fallback activity methods instead.
            disabled = false
        end

        if disabled then
            table.insert(disabledIdleConnections, connection)
        end
    end
end

local function restoreRobloxIdleConnections()
    for _, connection in ipairs(disabledIdleConnections) do
        if connection and type(connection.Enable) == "function" then
            pcall(function()
                connection:Enable()
            end)
        end
    end

    disabledIdleConnections = {}
end

local function stopAntiAfk()
    antiAfkWorkerToken += 1

    if antiAfkIdleConnection then
        pcall(function()
            antiAfkIdleConnection:Disconnect()
        end)
        antiAfkIdleConnection = nil
    end

    restoreRobloxIdleConnections()
end

local function startAntiAfk()
    stopAntiAfk()

    if not antiAfkEnabled then
        return
    end

    disableRobloxIdleConnections()

    -- Immediate response when Roblox reports Idled.
    antiAfkIdleConnection = LocalPlayer.Idled:Connect(function()
        if antiAfkEnabled then
            task.spawn(performAntiAfkActivity)
        end
    end)

    -- Proactive keep-alive:
    -- do not rely only on Idled, because some clients/executors do not fire it
    -- consistently before Roblox's idle timeout.
    antiAfkWorkerToken += 1
    local myToken = antiAfkWorkerToken

    task.spawn(function()
        -- Initial pulse after a short delay.
        task.wait(2)

        while antiAfkEnabled and myToken == antiAfkWorkerToken do
            performAntiAfkActivity()

            -- Keep well below Roblox's idle timeout without spamming input.
            local keepAliveSteps = IS_TOUCH_DEVICE and 6 or 9
            for _ = 1, keepAliveSteps do
                if not antiAfkEnabled or myToken ~= antiAfkWorkerToken then
                    break
                end
                task.wait(5)
            end
        end
    end)
end

-- Apply the saved/default state.
if antiAfkEnabled then
    task.defer(startAntiAfk)
end

