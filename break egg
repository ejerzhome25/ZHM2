                    task.spawn(function() onChanged(value) end)
                end
                refresh(currentOptions, counts, currentValue)
            end)
        end
    end

    header.Activated:Connect(function()
        opened = not opened
        options.Visible = opened
        arrow.Text = opened and "⌃" or "⌄"
    end)

    refresh({})

    return {
        Frame = wrapper,
        Refresh = refresh,
        Get = function() return currentValue end,
        Set = function(value)
            currentValue = value
            summary.Text = value or description or "None selected"
        end,
