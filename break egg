    -- Original scanner eligibility checks; its ESP output stays hidden.
    local function removeESP(model) models[model] = nil end
    local function addESP(model)
        if not model or not model.Parent or not model:IsA("Model") then return end
        if not Animals[model.Name] or models[model] then return end
        if hasBlockedDifficulty(model) or not getPart(model) then return end
        models[model] = true
        if AutoSnatch.Wake then AutoSnatch.Wake() end
    end
    local pendingModels = setmetatable({}, {__mode = "k"})
    local function scanModel(model)
        if not model:IsA("Model") or not Animals[model.Name] or not model.Parent then return end
        if hasBlockedDifficulty(model) then removeESP(model); return end
        if models[model] then return end
        if getPart(model) then addESP(model); return end
        -- Register ready models immediately; retry only incomplete streamed models.
        if pendingModels[model] then return end
        pendingModels[model] = true
        task.spawn(function()
            local deadline = os.clock() + 1
            while model.Parent and os.clock() < deadline do
                if hasBlockedDifficulty(model) then break end
                if getPart(model) then addESP(model); break end
                RunService.Heartbeat:Wait()
            end
            pendingModels[model] = nil
        end)
    end

    local function hideOverlay(object)
        if (object.Name == "VNDT_AnimalESP" and object:IsA("Highlight"))
            or (object.Name == "VNDT_AnimalName" and object:IsA("BillboardGui")) then
            object.Enabled = false
        end
    end
    function AutoSnatch.StartScanner()
        if scannerStarted then return end
        scannerStarted = true
        Workspace.DescendantAdded:Connect(function(object)
            hideOverlay(object)
            if object:IsA("Model") and Animals[object.Name] then
                scanModel(object)
                return
            end
            -- Parts, attributes represented by values, and late UI can all make
            -- an incomplete streamed animal ready without waiting for a rescan.
            if object.Parent then
                local parent = object.Parent
                while parent and parent ~= Workspace do
                    if parent:IsA("Model") and Animals[parent.Name] then
                        scanModel(parent)
                        break
                    end
                    parent = parent.Parent
                end
            end
        end)
        Workspace.DescendantRemoving:Connect(function(object)
            if models[object] then removeESP(object) end
        end)
        task.spawn(function()
            walkBatched(Workspace, function(object)
                hideOverlay(object)
                if object:IsA("Model") and Animals[object.Name] then scanModel(object) end
            end)
            while task.wait(0.75) do
                for model in pairs(models) do
                    if not model.Parent then models[model] = nil
                    elseif hasBlockedDifficulty(model) then removeESP(model) end
                end
            end
        end)
    end
    local partCache = setmetatable({}, {__mode = "k"})
    local function modelPosition(model)
        local part = partCache[model]
        if not part or not part.Parent or not part:IsDescendantOf(model) then
            part = getPart(model)
            partCache[model] = part
        end
        if part then return part.Position end
    end
    local sleepingThread = nil
    local wakeGeneration = 0
    function AutoSnatch.Wake()
        if sleepingThread then
            local thread = sleepingThread
            sleepingThread = nil
            wakeGeneration += 1
            task.spawn(thread)
        end
    end
    local function waitForTargetChange()
        sleepingThread = coroutine.running()
        wakeGeneration += 1
        local generation = wakeGeneration
        task.delay(0.01, function()
            if sleepingThread and wakeGeneration == generation then AutoSnatch.Wake() end
        end)
        coroutine.yield()
    end
    local cooldown = setmetatable({}, {__mode = "k"})
    local function higherPriority()
        return PetEggAutomation and PetEggAutomation.ShouldBlockSteal()
    end
    local lastStatusMessage, lastStatusKind
    local function status(message, kind)
        if message == lastStatusMessage and kind == lastStatusKind then return end
        lastStatusMessage, lastStatusKind = message, kind
        if statusSink then statusSink("Auto Snatch: " .. message, kind or "working") end
    end
    local preparedPrompts = setmetatable({}, {__mode = "k"})
    local function fireSnatchPromptRapid(prompt)
        if not prompt or not prompt.Parent or not prompt.Enabled then return false end
        if not preparedPrompts[prompt] then
            local ok = pcall(function()
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 150)
                prompt.RequiresLineOfSight = false
            end)
            preparedPrompts[prompt] = ok
        end
        local fired = false
        -- Zero-wait burst for the logged StealPrompt; yield only in the outer loop.
        for _ = 1, 5 do
            if not AutoSnatch.enabled or higherPriority() or not prompt.Parent or not prompt.Enabled then break end
            local ok = false
            if type(fireproximityprompt) == "function" then
                ok = pcall(fireproximityprompt, prompt, 0, true)
            end
            if not ok then
                ok = pcall(function()
                    prompt:InputHoldBegin()
                    prompt:InputHoldEnd()
                end)
            end
            fired = ok or fired
        end
        return fired
    end
    local function animalName(prompt)
        local text = tostring(prompt.ObjectText or ""):gsub("<[^>]*>", ""):gsub("%b[]", "")
        local name = allowed[key(text)]
        if name then return name end
        name = allowed[key(prompt.Name)]
        if name then return name end
        local node = prompt.Parent
        while node and node ~= Workspace do
            name = allowed[key(node.Name)]
            if name then return name end
            for _, attribute in ipairs({"PetName", "AnimalName", "Species", "PetType", "DisplayName"}) do
                name = allowed[key(node:GetAttribute(attribute))]
                if name then return name end
            end
            node = node.Parent
        end
    end
    local readWeight
    local weightCache = setmetatable({}, {__mode = "k"})
    local function parseWeight(value, requireUnit)
        if type(value) == "number" then
            if not requireUnit and value >= 0 and value < math.huge then return value end
            return nil
        end
        if type(value) ~= "string" then return nil end
        local text = value:lower():gsub("<[^>]*>", ""):gsub(",", "")
        local number = text:match("([%+%-]?%d*%.?%d+)%s*kg")
            or text:match("([%+%-]?%d*%.?%d+)%s*kilograms?")
        if not number and not requireUnit then number = text:match("^%s*(%d*%.?%d+)%s*$") end
        local kg = tonumber(number)
        if kg and kg >= 0 and kg < math.huge then return kg end
    end
    local function choose()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local best, bestName, distance = nil, nil, math.huge
        local bestWeight = nil
        for model in pairs(models) do
            local name = allowed[key(model.Name)]
            if name and AutoSnatch.selected[name] == true and (cooldown[model] or 0) <= os.clock() and not excluded(model) then
                local position = modelPosition(model)
                if position then
                    local d = (root.Position - position).Magnitude
                    local kg = AutoSnatch.highestKg and readWeight(model, name) or nil
                    local score, bestScore = kg or -math.huge, bestWeight or -math.huge
                    local better = not best or (AutoSnatch.highestKg and score > bestScore)
                        or ((not AutoSnatch.highestKg or score == bestScore) and d < distance)
                    if better then best, bestName, distance, bestWeight = model, name, d, kg end
                end
            end
        end
        return best, bestName, bestWeight
    end
    local function findStealPrompt(model, name)
        if excluded(model) then return nil end
        local position = model.Parent and modelPosition(model)
        if not position then return nil end
        -- ActionLogs_V10 records Workspace.PromptAnchor.StealPrompt.
        -- Bind that shared anchor to the selected animal before activating it.
        local anchor = Workspace:FindFirstChild("PromptAnchor")
        local loggedPrompt = anchor and anchor:FindFirstChild("StealPrompt")
        if loggedPrompt and loggedPrompt:IsA("ProximityPrompt") and loggedPrompt.Enabled and not excluded(loggedPrompt) then
            local promptPosition = getPromptWorldPosition(loggedPrompt)
            local detectedName = animalName(loggedPrompt)
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if promptPosition then
                local distance = (position - promptPosition).Magnitude
                if (detectedName == name and distance <= 60)
                    or (not detectedName and distance <= 8 and root and (root.Position - promptPosition).Magnitude <= 12) then
                    return loggedPrompt
                end
            end
        end
        local best, bestDistance = nil, math.huge
        for prompt in pairs(ensureProximityPromptCache()) do
            if prompt.Parent and prompt.Enabled then
                local action = key(prompt.ActionText)
                if action:find("steal", 1, true) or action:find("snatch", 1, true) then
                    local promptPosition = getPromptWorldPosition(prompt)
                    if promptPosition then
                        local d = (position - promptPosition).Magnitude
                        -- Some games place the prompt beside the displayed animal model.
                        if prompt:IsDescendantOf(model) and not excluded(prompt) then return prompt end
                        if d <= 60 and animalName(prompt) == name and d < bestDistance and not excluded(prompt) then
                            best, bestDistance = prompt, d
                        end
                    end
                end
            end
        end
        return best
    end
    readWeight = function(model, name)
        local now = os.clock()
        local cached = weightCache[model]
        if cached and now - cached.time < 1 then return cached.kg end
        local fields = {kg = true, weight = true, weightkg = true, animalweight = true,
            petweight = true, kilograms = true}
        local function inspect(object)
            for field, value in pairs(object:GetAttributes()) do
                if fields[key(field)] then
                    local kg = parseWeight(value, false)
                    if kg ~= nil then return kg end
                end
            end
            if (object:IsA("NumberValue") or object:IsA("IntValue") or object:IsA("StringValue"))
                and fields[key(object.Name)] then return parseWeight(object.Value, false) end
        end
        local kg = inspect(model)
        if kg == nil then
            local descendants = model:GetDescendants()
            for _, object in ipairs(descendants) do
                kg = inspect(object)
                if kg ~= nil then break end
            end
            if kg == nil then
                for _, object in ipairs(descendants) do
                    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                        kg = parseWeight(object.Text, true)
                    elseif object:IsA("ProximityPrompt") then
                        kg = parseWeight(object.ObjectText, true)
                    end
                    if kg ~= nil then break end
                end
            end
        end
        if kg == nil then
            local prompt = findStealPrompt(model, name)
            if prompt then kg = parseWeight(prompt.ObjectText, true) end
        end
        weightCache[model] = {time = now, kg = kg}
        return kg
    end
    local follow = {connection = nil, proxy = nil, root = nil, goal = nil}
    function AutoSnatch.CancelFollow()
        if follow.connection then follow.connection:Disconnect(); follow.connection = nil end
        if AutoSnatch.followTween then AutoSnatch.followTween:Cancel(); AutoSnatch.followTween = nil end
        if follow.proxy then follow.proxy:Destroy(); follow.proxy = nil end
        follow.root, follow.goal = nil, nil
    end
    local function followTarget(model, prompt)
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local position = prompt and prompt.Parent and prompt.Enabled and getPromptWorldPosition(prompt)
            or (model.Parent and modelPosition(model))
        if not root or not position or not AutoSnatch.protecting or higherPriority() then
            AutoSnatch.CancelFollow()
            return
        end
        local goal = Vector3.new(position.X, 0, position.Z + 5)
        if AutoSnatch.followTween and follow.root == root and follow.goal
            and (follow.goal - goal).Magnitude < 0.75
            and AutoSnatch.followTween.PlaybackState == Enum.PlaybackState.Playing then return end
        local current = Vector3.new(root.Position.X, 0, root.Position.Z)
        if (current - goal).Magnitude < 0.6 then AutoSnatch.CancelFollow(); return end
        AutoSnatch.CancelFollow()
        releaseAntiPushMover()
        root.Anchored = false
        follow.root, follow.goal = root, goal
        local proxy = Instance.new("Vector3Value")
        proxy.Value = current
        follow.proxy = proxy
        AutoSnatch.followTween = TweenService:Create(proxy,
            TweenInfo.new(0.20, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Value = goal})
        follow.connection = RunService.Heartbeat:Connect(function()
            if not AutoSnatch.enabled or not AutoSnatch.protecting or higherPriority()
                or not root.Parent or LocalPlayer.Character ~= character or excluded(model)
                or (prompt and (not prompt.Parent or not prompt.Enabled)) then
                AutoSnatch.CancelFollow()
                return
            end
            root.CFrame = CFrame.new(proxy.Value.X, root.Position.Y, proxy.Value.Z) * root.CFrame.Rotation
            if AutoSnatch.followTween and AutoSnatch.followTween.PlaybackState == Enum.PlaybackState.Completed then
                AutoSnatch.CancelFollow()
            end
        end)
        AutoSnatch.followTween:Play()
    end

    local function returnToBoard()
        AutoSnatch.CancelFollow()
        AutoSnatch.protecting = false
        protectCharacterStep()
        clearTargetLock()
        local _, destination = findTreadmillBoard()
        destination = destination or RETURN_CFRAME
        local lastTeleport = -math.huge
        while AutoSnatch.enabled and not higherPriority() do
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                if (root.Position - destination.Position).Magnitude <= 8 then
                    status("Returned to treadmill • holding 0.2s", "success")
                    local holdUntil = os.clock() + RETURN_BOARD_HOLD
                    while os.clock() < holdUntil do
                        -- Egg automation has higher movement priority. If Auto
                        -- Place Eggs requests movement during this hold, release
                        -- Auto Snatch immediately instead of blocking placement.
                        if not AutoSnatch.enabled or higherPriority() then
                            return false
                        end
                        RunService.Heartbeat:Wait()
                    end
                    return true
                end
                if os.clock() - lastTeleport >= 0.15 then
                    teleportCharacter(destination)
                    lastTeleport = os.clock()
                end
            end
            RunService.Heartbeat:Wait()
        end
        return false
    end
    function AutoSnatch.Start()
        if AutoSnatch.running then AutoSnatch.Wake(); return end
        AutoSnatch.StartScanner()
        AutoSnatch.running = true
        task.spawn(function()
            local needsReturn = false
            while AutoSnatch.enabled do
                local returnedThisCycle = false
                local ok, err = pcall(function()
                    if higherPriority() then
                        status("Paused • " .. tostring(PetEggAutomation.GetBlockReason() or "Egg automation") .. " has priority", "warning")
                        return
                    end
                    local model, name, kg
                    if not needsReturn then
                        model, name, kg = choose()
                        if not model then
                            status(getSelectedCount(AutoSnatch.selected) == 0
                                and "Select animals in Snatch Animals" or "Scanning selected animal models…")
                            return
                        end
                    end
                    AutoSnatch.pending = true
                    while AutoSnatch.enabled and not higherPriority()
                        and (autoStealCycleBusy or targetLockActive or autoStealReturning) do
                        RunService.Heartbeat:Wait()
                    end
                    if not AutoSnatch.enabled or higherPriority() then return end
                    AutoSnatch.busy = true
                    AutoSnatch.pending = false
                    if not needsReturn then
                        if excluded(model, true) or hasBlockedDifficulty(model) or AutoSnatch.selected[name] ~= true then return end
                        local position = modelPosition(model)
                        if not position then return end
                        local prompt = nil
                        status("Teleporting to " .. name .. (AutoSnatch.highestKg
                            and (kg ~= nil and string.format(" • %.2f kg", kg) or " • KG unknown") or ""))
                        AutoSnatch.protecting = true
                        if not teleportCharacter(CFrame.new(position + Vector3.new(0, 2, 5))) then return end
                        needsReturn = true
                        protectCharacterStep()
                        prompt = findStealPrompt(model, name)
                        local attempted = false
                        local completed = false
                        local deadline = os.clock() + 10
                        while AutoSnatch.enabled and not higherPriority() and AutoSnatch.selected[name] == true and (attempted or os.clock() < deadline) do
                            if attempted and prompt and (not prompt.Parent or not prompt.Enabled) then
                                completed = true
                                status("Steal prompt completed • returning", "success")
                                break
                            end
                            if excluded(model) or hasBlockedDifficulty(model) then
                                status("Target entered a base or is being carried • returning", "warning")
                                break
                            end
                            prompt = prompt or findStealPrompt(model, name)
                            followTarget(model, prompt)
                            if prompt and prompt.Parent and prompt.Enabled then
                                if not AutoSnatch.enabled or higherPriority() or excluded(model, true) or excluded(prompt, true) then break end
                                status("Stealing " .. name)
                                attempted = fireSnatchPromptRapid(prompt) or attempted
                            else
                                prompt = nil
                                status("At " .. name .. " • waiting for steal prompt")
                            end
                            RunService.Heartbeat:Wait()
                        end
                        cooldown[model] = os.clock() + 10
                        if AutoSnatch.enabled and not higherPriority() and not completed then
                            status("Steal unconfirmed • returning before retry", "warning")
                        end
                    end
                    if AutoSnatch.enabled and not higherPriority() then
                        returnedThisCycle = returnToBoard()
                        needsReturn = not returnedThisCycle
                    end
                end)
                AutoSnatch.CancelFollow()
                if AutoSnatch.protecting then
                    AutoSnatch.protecting = false
                    pcall(protectCharacterStep)
                end
                AutoSnatch.pending = false
                AutoSnatch.busy = false
                if not ok then status("Error: " .. tostring(err), "error") end
                -- After return, scan immediately. Idle cycles wake on new models
                -- or the short fallback check without busy-looping an empty map.
                if not returnedThisCycle then waitForTargetChange() end
            end
            AutoSnatch.pending = false
            AutoSnatch.busy = false
            AutoSnatch.running = false
            AutoSnatch.protecting = false
            AutoSnatch.CancelFollow()
        end)
    end
end)()
end

